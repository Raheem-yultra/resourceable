# Copy to .env.local for development. NEVER commit real values.
# Validate any environment before deploying with:  npm run preflight

# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
# Pooled connection — used by the app at runtime. Port 6543, pgbouncer=true.
DATABASE_URL="postgresql://postgres:password@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# DIRECT connection — used by `prisma db push` / migrations ONLY.
# MUST be port 5432 and MUST NOT contain pgbouncer/connection_limit. If this is
# the same as DATABASE_URL, `prisma db push` hangs forever with no error, because
# the transaction pooler cannot run DDL.
DIRECT_URL="postgresql://postgres:password@HOST:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Generate: openssl rand -base64 32   (use a DIFFERENT value per environment)
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
# Canonical public origin, no trailing slash. Every emailed link (verification,
# password reset, provider approval) is built from this. In production the
# app REFUSES to fall back to localhost — an unset value throws rather than
# mailing users links that point at a dev machine.
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# https://resend.com/api-keys — without it, every transactional email fails.
RESEND_API_KEY=""
# Verified sender. Leaving this unset falls back to Resend's shared sandbox
# sender (onboarding@resend.dev), which is accepted by the API but only delivers
# to your own Resend account address and @resend.dev test inboxes. That fallback
# is a DEV convenience: in production an unset EMAIL_FROM throws instead.
# The domain must be verified at https://resend.com/domains first.
EMAIL_FROM="ResourceAble <no-reply@yourdomain.com>"
# Reply-To on all outbound mail. Must be a mailbox that actually exists, or
# replies from users and providers bounce.
SUPPORT_EMAIL="support@yourdomain.com"

# ---------------------------------------------------------------------------
# Billing: not in use. Providers are not charged — creating an account, submitting
# details, and being approved by an admin is all it takes to list. Nothing to set
# here: no payment provider is wired up, and the billing columns have been dropped
# from the schema (see prisma/drop-billing.sql).
# ---------------------------------------------------------------------------
